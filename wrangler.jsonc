// Cloudflare Workers static assets. Vite builds the site into dist/, and every request is answered
// by a file there. Deploy with: npm run build && npx wrangler deploy
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "name": "netv",
  // Set to the date of your first deploy. Changing it later can change runtime behaviour.
  "compatibility_date": "2026-10-13",
  "assets": {
    // Only the compiled site ships; source, docs, tools and node_modules stay out.
    "directory": "dist",
    // Documented default: "/" serves index.html, "/file.html" redirects to "/file".
    "html_handling": "auto-trailing-slash"
  }
}
