# Development files that stay out of the repository. The published site is
# built into dist/, which Wrangler uploads instead of the repository root.

# Installed packages and the Vite build output.
node_modules/
dist/

# Wrangler's own state: the local caches under cache/, tmp/, and miniflare's
# SQLite databases (cache, d1, kv, r2, observability) under state/v3/.
.wrangler/

# Wrangler reads .dev.vars for local secrets. That file never ships and never
# enters history; the deployed site carries no secrets at all.
.dev.vars

# Editor and OS droppings — this repository is edited from Windows through WSL.
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
